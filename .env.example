# Create a Govee developer API key at https://developer.govee.com/
GOVEE_API_KEY=replace-me
PORT=3000
# Bind address for the HTTP/WS server. Loopback by default (Tailscale Serve
# terminates TLS); set to 0.0.0.0 to expose on all interfaces directly.
HOST=127.0.0.1

# Optional MQTT bridge for Zigbee2MQTT events and virtual light topics.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=glow-control
ZIGBEE2MQTT_BASE_TOPIC=zigbee2mqtt
BRIDGE_RULES_FILE=data/bridge-rules.json
