{
  "name": "govee-lights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:api": "bun --watch src/index.ts",
    "dev": "concurrently -k -n web,api -c cyan,magenta \"bun run dev:web\" \"bun run dev:api\"",
    "build:web": "vite build",
    "start": "bun src/index.ts",
    "check": "bun build src/index.ts --target bun --outdir .tmp-build && vite build"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "bonjour-service": "^1.4.4",
    "mqtt": "^5.15.2",
    "react": "19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "vite": "^8.2.0"
  }
}
